#!/usr/bin/env python3
"""The program of Photo Offloader.app: start everything and open the dashboard.

With --dashboard or --if-closed it only opens the dashboard, as bin/photo-offloader-dashboard does.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from photo_offloader.dashboard.launcher import app_main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(app_main())
